# Disposable Linux environment for manually smoke-testing the real wizard on
# Fedora — exercises the dnf fallback path for GUI apps.
# Not part of the automated pytest suite — see tests/integration/README.md.
FROM fedora:40

RUN dnf install -y \
    gcc make curl git sudo ca-certificates procps-ng file \
    python3 python3-pip \
    && dnf clean all

# Homebrew refuses to run as root, and most of the real install steps
# (chsh, sudo dnf install, ...) assume a normal sudo-capable user.
RUN useradd -m -s /bin/bash dev && \
    echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev

USER dev
WORKDIR /home/dev/workstation-setup
COPY --chown=dev:dev . .

RUN python3 -m venv .venv && \
    .venv/bin/pip install -e ".[dev]" -q

CMD ["/bin/bash"]
